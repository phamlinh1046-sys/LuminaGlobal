# ============================================================
#  Lumina — copy thành .env và điền giá trị thật
#  KHÔNG commit file .env
# ============================================================

# GoClaw AI Gateway (admin.luminaglobal.info.vn → API Keys → Tạo API Key)
GOCLAW_API_KEY=goclaw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOCLAW_BASE_URL=https://admin.luminaglobal.info.vn
GOCLAW_AGENT=lumi

# Resend email (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Lumina <hello@luminaglobal.info.vn>

# Domain
LUMINA_BASE_DOMAIN=luminaglobal.info.vn

# Database path trên VPS (để trống = dùng default Desktop/Lumina/lumina.db)
# LUMINA_DB_PATH=/var/www/data/lumina.db

# Admin panel
ADMIN_USERNAME=admin
# php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

# BAT product
SITE_URL=https://luminaglobal.info.vn/becomingatrainer/
