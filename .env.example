# Admin panel
ADMIN_USERNAME=admin
# php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

# BAT product
SITE_URL=https://luminaglobal.info.vn/becomingatrainer/
